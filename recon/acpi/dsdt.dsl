                Else
                {
                    ADBG ("Assume WWAN DL23() is already done")
                }

                Sleep (TR2B)
                SGOV (WBRS, PBRS)
                If ((Arg0 == Zero))
                {
                    Sleep (TBTG)
                }
                ElseIf ((Arg0 == One))
                {
                    SPCO (WCLK, Zero)
                    Sleep (TB2F)
                    SGOV (WFCP, (~PFCP & One))
                    Sleep (TFDI)
                }
                Else
                {
                }
            }

            Method (SHRF, 0, NotSerialized)
            {
                PSD0 (SLOT)
                SPCO (WCLK, One)
                SGOV (WFCP, PFCP)
                Sleep (TN2B)
                SGOV (WBRS, (~PBRS & One))
                Sleep (TB2R)
                SGOV (PRST, (~WPRP & One))
