                CreateQWordField (NBUF, \_SB.PC00.HDAS._Y2A._MAX, NMAS)  // _MAX: Maximum Base Address
                CreateQWordField (NBUF, \_SB.PC00.HDAS._Y2A._LEN, NLEN)  // _LEN: Length
